<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinExe: Windows opens no console window for the app, and drops what it writes to the console. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
<!--#if (style != "default" && !markup) -->
    <SlintStyle>SLINT_STYLE</SlintStyle>
<!--#endif -->
  </PropertyGroup>

<!--#if (markup) -->
  <!-- Debug: `dotnet watch` applies changes to the C# code, and the UI, while the app runs. -->
<!--#else -->
  <!-- Debug: `dotnet watch` reloads changes to the .slint files and to the C# code while the app runs. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SlintLivePreview>true</SlintLivePreview>
  </PropertyGroup>
<!--#endif -->

  <!-- Release: `dotnet publish -c Release -r <runtime identifier>` builds a native executable with Native AOT. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

<!--#if (markup) -->
  <ItemGroup>
    <PackageReference Include="SLINT_PACKAGE_ID.Markup" Version="SLINT_VERSION" />
  </ItemGroup>
<!--#else -->
  <ItemGroup>
    <SlintFile Include="ui/app-window.slint" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SLINT_PACKAGE_ID" Version="SLINT_VERSION" />
<!--#if (mvvm) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->

</Project>
