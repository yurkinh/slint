// A component for UI written in C#, with Markup="true" in Slint.Tests.csproj.
import { Button } from "std-widgets.slint";

export enum CardTone { plain, highlighted }

export component MarkupCard inherits Rectangle {
    in property <string> title;
    in property <CardTone> tone;
    in property <TextHorizontalAlignment> title-alignment;
    in-out property <bool> expanded;
    callback opened(string);
    background: tone == CardTone.highlighted ? #ffd : #fff;
    VerticalLayout {
        Text {
            text: root.title;
            horizontal-alignment: root.title-alignment;
        }
        Button {
            text: "Open";
            clicked => { root.expanded = !root.expanded; root.opened(root.title); }
        }
    }
}
